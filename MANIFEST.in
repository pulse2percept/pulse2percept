# Include metadata files
include LICENSE CONTRIBUTING* CODE_OF_CONDUCT* Makefile* MANIFEST.in setup* README.*

# Include Cython source files
recursive-include pulse2percept *.pyx *.pxd *.h
recursive-include pulse2percept *.c *.cpp *.so

# Include documentation files
recursive-include doc *

# Include examples
recursive-include examples *

# Include the generator for the packaged displacement field (provenance for
# pulse2percept/topography/retina/data/montesano2020.npz)
include tools/generate_montesano2020_map.py

# Explicitly include Numpy headers
# (This ensures the source distribution works across environments)
recursive-include numpy/core/include *.h

exclude wheelhouse/*
prune wheelhouse